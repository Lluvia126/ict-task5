# 复制为 .env 并填入真实 Key
QWEN_API_KEY=你的_qwen_api_key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-vl-max

# 图谱同步：auto=抽取/删除时自动同步到 Neo4j；off=关闭自动同步（只保留手动接口）
GRAPH_SYNC_MODE=auto

# ===== 公网部署安全（详见 docs/公网部署与安全说明.md）=====
# 管理口令：删除/清空/图谱重建等破坏性接口需请求头 X-Admin-Token；留空=本地开发不校验
ADMIN_TOKEN=
# 1=公网模式（未配置 ADMIN_TOKEN 时破坏性接口直接关闭，避免裸奔）
PUBLIC_MODE=0
# 是否允许匿名上传/抽取：评委自助测试任务三需要 1；设为 0 则仅管理员可用
ALLOW_ANON_UPLOAD=1
ALLOW_ANON_EXTRACT=1
# 允许匿名删除/清空：1=前端按钮可直接用（公网任何人都能调，注意备份）；0=需 X-Admin-Token
ALLOW_ANON_DELETE=0
QUOTA_DELETE_PER_IP_DAY=50
# 配额：每 IP 每天上传/抽取次数；抽取另有全局每日上限（控制 AI 费用）
# 0 = 不限制（本地联调用；公网环境建议保留具体数值，避免被刷）
QUOTA_UPLOAD_PER_IP_DAY=10
QUOTA_EXTRACT_PER_IP_DAY=20
QUOTA_EXTRACT_GLOBAL_PER_DAY=300
# 删除/清空的每日次数（仅在 ALLOW_ANON_DELETE=1 时生效）
QUOTA_DELETE_PER_IP_DAY=50
# 上传大小上限(MB)；跨域白名单（逗号分隔，* 表示放开所有来源）
MAX_UPLOAD_MB=100
ALLOWED_ORIGINS=*

# QWEN_MODEL 可以是公开模型名（qwen-max / qwen-plus / qwen-long），
# 也可以是百炼「模型部署」生成的托管部署 ID（如 qwen3-8b-xxxxxxxxxxxx）
# 注意：Qwen3 系列在非流式调用下必须 enable_thinking=false（代码已默认处理）
